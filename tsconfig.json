{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/pages/index.tsx",
    "src/pages/login/**/*.ts",
    "src/pages/login/**/*.tsx",
    "src/pages/home/**/*.ts",
    "src/pages/home/**/*.tsx",
    "src/pages/simulator/**/*.tsx",
    "src/pages/compare/**/*.tsx",
    "src/pages/law/**/*.tsx",
    "src/pages/lab/**/*.tsx",
    "src/pages/challenges/**/*.tsx",
    "src/pages/features/**/*.ts",
    "src/pages/features/**/*.tsx",
    "src/componentes/**/*.ts",
    "src/componentes/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
